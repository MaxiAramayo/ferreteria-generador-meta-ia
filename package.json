{
  "name": "aramayo-content-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de contenido y publicación de Ferretería y Lubricentro Aramayo.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "config:test": "node --test packages/configuration/src/*.test.ts",
    "config:typecheck": "tsc --project packages/configuration/tsconfig.json",
    "dev": "pnpm --recursive --filter \"./packages/*\" build && pnpm --recursive --parallel --filter \"./apps/*\" dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:clean": "node tools/local-infrastructure/cli.ts clean",
    "infra:config": "node tools/local-infrastructure/cli.ts config",
    "infra:down": "node tools/local-infrastructure/cli.ts down",
    "infra:health": "node tools/local-infrastructure/cli.ts health",
    "infra:restart": "node tools/local-infrastructure/cli.ts restart",
    "infra:test": "node --test tools/local-infrastructure/*.test.ts",
    "infra:typecheck": "tsc --project tools/local-infrastructure/tsconfig.json",
    "infra:up": "node tools/local-infrastructure/cli.ts up",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke": "node tools/smoke/cli.ts",
    "smoke:typecheck": "tsc --project tools/smoke/tsconfig.json",
    "test": "pnpm --recursive test && pnpm run infra:test && node --test tools/smoke/*.test.ts",
    "typecheck": "pnpm --recursive typecheck && pnpm run infra:typecheck && pnpm run smoke:typecheck",
    "verify": "pnpm run verify:stack && pnpm run verify:plan && pnpm run format:check && pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run smoke",
    "verify:plan": "node tools/verify-plan.mjs",
    "verify:stack": "node tools/verify-stack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "pg": "catalog:",
    "prettier": "catalog:",
    "redis": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
