NODE_ENV=development
APP_TIMEZONE=America/Argentina/Cordoba

# Contrato público del navegador. Nunca agregar secretos con NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# API y worker.
PORT=3001
WEB_ORIGIN=http://localhost:3000
AUTH_SESSION_TTL_SECONDS=43200
TRUST_PROXY_HOPS=0
WORKER_CONCURRENCY=4
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Infraestructura local. Definir contraseñas propias después de copiar a .env.
POSTGRES_USER=aramayo
POSTGRES_PASSWORD=
POSTGRES_DB=aramayo_content
POSTGRES_PORT=5432
REDIS_PASSWORD=
REDIS_PORT=6379

DATABASE_URL=
REDIS_URL=

OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_VECTOR_STORE_ID=
OPENAI_MODEL_ROUTINE=gpt-5.6-luna
OPENAI_MODEL_BRIEF=gpt-5.6-terra
OPENAI_MODEL_COMPLEX=gpt-5.6-sol
OPENAI_REQUEST_TIMEOUT_MS=60000
OPENAI_MAX_INPUT_CHARACTERS=50000
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BASE_DELAY_MS=500

ODOO_CONTENT_API_BASE_URL=
ODOO_CONTENT_API_TOKEN=
ODOO_CONTENT_API_ORGANIZATION_ID=
ODOO_CONTENT_API_LOCATION_MAP=
ODOO_CONTENT_API_TIMEOUT_MS=8000
ODOO_CONTENT_API_MAX_CALLS=8

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aramayo-content-platform

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_API_VERSION=

# Llaves versionadas: v1:<32 bytes en Base64>. La primera es la activa.
TOKEN_ENCRYPTION_KEYS=
