{
  "name": "@aramayo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "pnpm --workspace-root exec prisma generate && tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@aramayo/brand-knowledge": "workspace:*",
    "@aramayo/domain": "workspace:*",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "prisma": "catalog:",
    "typescript": "catalog:"
  }
}
