generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active   @map("active")
  disabled @map("disabled")

  @@map("user_status")
}

enum MembershipStatus {
  active  @map("active")
  revoked @map("revoked")

  @@map("membership_status")
}

enum OrganizationRole {
  admin     @map("admin")
  editor    @map("editor")
  approver  @map("approver")
  publisher @map("publisher")
  viewer    @map("viewer")

  @@map("organization_role")
}

enum AuthenticationEventType {
  login_succeeded          @map("login_succeeded")
  login_failed             @map("login_failed")
  login_rate_limited       @map("login_rate_limited")
  session_revoked          @map("session_revoked")
  sessions_revoked         @map("sessions_revoked")
  membership_roles_changed @map("membership_roles_changed")
  membership_revoked       @map("membership_revoked")

  @@map("authentication_event_type")
}

enum ConfigurationTargetType {
  organization @map("organization")
  brand        @map("brand")
  location     @map("location")

  @@map("configuration_target_type")
}

enum PublicationStatus {
  draft               @map("draft")
  retrieving_context  @map("retrieving_context")
  missing_information @map("missing_information")
  generating_assets   @map("generating_assets")
  ready_for_review    @map("ready_for_review")
  approved            @map("approved")
  scheduled           @map("scheduled")
  publishing          @map("publishing")
  partially_published @map("partially_published")
  published           @map("published")
  generation_failed   @map("generation_failed")
  validation_failed   @map("validation_failed")
  publish_failed      @map("publish_failed")
  cancelled           @map("cancelled")
  expired             @map("expired")

  @@map("publication_status")
}

enum PublicationRevisionStatus {
  draft      @map("draft")
  in_review  @map("in_review")
  approved   @map("approved")
  superseded @map("superseded")

  @@map("publication_revision_status")
}

enum PublicationTransitionCommandType {
  advance       @map("advance")
  approve       @map("approve")
  cancel        @map("cancel")
  edit_approved @map("edit_approved")
  expire        @map("expire")
  fail          @map("fail")

  @@map("publication_transition_command_type")
}

enum MediaAssetStatus {
  pending_upload   @map("pending_upload")
  available        @map("available")
  failed           @map("failed")
  pending_deletion @map("pending_deletion")
  deleted          @map("deleted")

  @@map("media_asset_status")
}

enum MediaAssetOrigin {
  approved_library  @map("approved_library")
  commercial_system @map("commercial_system")
  generated         @map("generated")
  uploaded          @map("uploaded")

  @@map("media_asset_origin")
}

enum MediaStorageProvider {
  brand_library @map("brand_library")
  cloudinary    @map("cloudinary")

  @@map("media_storage_provider")
}

enum IdempotencyStatus {
  processing @map("processing")
  completed  @map("completed")

  @@map("idempotency_status")
}

enum OutboxMessageStatus {
  pending     @map("pending")
  processing  @map("processing")
  delivered   @map("delivered")
  dead_letter @map("dead_letter")

  @@map("outbox_message_status")
}

enum KnowledgeDocumentVersionStatus {
  pending_upload @map("pending_upload")
  uploaded       @map("uploaded")
  indexing       @map("indexing")
  active         @map("active")
  superseded     @map("superseded")
  retiring       @map("retiring")
  retired        @map("retired")
  sync_failed    @map("sync_failed")

  @@map("knowledge_document_version_status")
}

enum ContentBriefRunStatus {
  pending
  generated
  rejected
  cancelled

  @@map("content_brief_run_status")
}

enum GenerationRunStatus {
  pending
  running
  completed
  failed
  cancelled

  @@map("generation_run_status")
}

enum GenerationVariantStatus {
  pending
  succeeded
  failed
  discarded

  @@map("generation_variant_status")
}

enum GenerationAttemptStatus {
  reserved
  in_flight
  settled
  unconfirmed
  released

  @@map("generation_attempt_status")
}

enum KnowledgeRemoteStatus {
  not_uploaded @map("not_uploaded")
  uploaded     @map("uploaded")
  in_progress  @map("in_progress")
  completed    @map("completed")
  failed       @map("failed")
  detached     @map("detached")

  @@map("knowledge_remote_status")
}

model Organization {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique(map: "organizations_slug_key") @db.VarChar(80)
  legalName   String   @map("legal_name") @db.VarChar(160)
  displayName String   @map("display_name") @db.VarChar(120)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  approvalSnapshots      ApprovalSnapshot[]
  auditEvents            AuditEvent[]
  authenticationEvents   AuthenticationEvent[]
  authenticationSessions AuthenticationSession[]
  brands                 Brand[]
  configurationEvents    OrganizationConfigurationEvent[]
  contentBriefRuns       ContentBriefRun[]
  generationRuns         GenerationRun[]
  generationRunVariants  GenerationRunVariant[]
  generationPolicies     GenerationPolicy[]
  generationAttempts     GenerationAttempt[]
  generationBudgetAlerts GenerationBudgetAlert[]
  locations              Location[]
  mediaAssets            MediaAsset[]
  memberships            OrganizationMembership[]
  idempotencyRecords     IdempotencyRecord[]
  knowledgeDocuments     KnowledgeDocument[]
  knowledgeVersions      KnowledgeDocumentVersion[]
  outboxMessages         OutboxMessage[]
  publications           Publication[]
  revisionMedia          PublicationRevisionMedia[]
  revisions              PublicationRevision[]
  stateTransitions       PublicationStateTransition[]

  @@map("organizations")
}

model KnowledgeDocument {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  sourceKey       String   @map("source_key") @db.VarChar(160)
  title           String   @db.VarChar(180)
  activeVersionId String?  @map("active_version_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions      KnowledgeDocumentVersion[] @relation("KnowledgeDocumentVersions")
  activeVersion KnowledgeDocumentVersion?  @relation("ActiveKnowledgeDocumentVersion", fields: [organizationId, id, activeVersionId], references: [organizationId, documentId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, sourceKey], map: "knowledge_documents_organization_source_key")
  @@unique([organizationId, id], map: "knowledge_documents_organization_id_key")
  @@unique([organizationId, id, activeVersionId], map: "knowledge_documents_active_version_key")
  @@index([organizationId, activeVersionId], map: "knowledge_documents_organization_active_idx")
  @@map("knowledge_documents")
}

model KnowledgeDocumentVersion {
  id                    String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String                         @map("organization_id") @db.Uuid
  documentId            String                         @map("document_id") @db.Uuid
  version               Int
  contentHash           String                         @map("content_hash") @db.Char(64)
  filename              String                         @db.VarChar(255)
  mimeType              String                         @map("mime_type") @db.VarChar(120)
  byteSize              BigInt                         @map("byte_size")
  documentType          String                         @map("document_type") @db.VarChar(80)
  brand                 String                         @db.VarChar(120)
  locationIds           Json                           @map("location_ids")
  sourceOwner           String                         @map("source_owner") @db.VarChar(120)
  sensitivity           String                         @db.VarChar(20)
  approvalReference     String                         @map("approval_reference") @db.VarChar(160)
  approvedAt            DateTime                       @map("approved_at") @db.Timestamptz(3)
  effectiveFrom         DateTime                       @map("effective_from") @db.Timestamptz(3)
  effectiveUntil        DateTime?                      @map("effective_until") @db.Timestamptz(3)
  status                KnowledgeDocumentVersionStatus @default(pending_upload)
  providerVectorStoreId String                         @map("provider_vector_store_id") @db.VarChar(120)
  providerFileId        String?                        @map("provider_file_id") @db.VarChar(120)
  remoteStatus          KnowledgeRemoteStatus          @default(not_uploaded) @map("remote_status")
  failureCode           String?                        @map("failure_code") @db.VarChar(80)
  failureMessage        String?                        @map("failure_message") @db.VarChar(300)
  failureRetryable      Boolean?                       @map("failure_retryable")
  activatedAt           DateTime?                      @map("activated_at") @db.Timestamptz(3)
  retiredAt             DateTime?                      @map("retired_at") @db.Timestamptz(3)
  createdAt             DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document     KnowledgeDocument  @relation("KnowledgeDocumentVersions", fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  activeFor    KnowledgeDocument? @relation("ActiveKnowledgeDocumentVersion")

  @@unique([organizationId, id], map: "knowledge_document_versions_organization_id_key")
  @@unique([organizationId, documentId, id], map: "knowledge_document_versions_document_id_key")
  @@unique([documentId, contentHash], map: "knowledge_document_versions_document_hash_key")
  @@unique([organizationId, documentId, version], map: "knowledge_document_versions_document_version_key")
  @@index([organizationId, status, updatedAt, id], map: "knowledge_document_versions_recovery_idx")
  @@index([organizationId, providerVectorStoreId, providerFileId], map: "knowledge_document_versions_remote_idx")
  @@map("knowledge_document_versions")
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String     @unique(map: "users_email_key") @db.VarChar(254)
  displayName         String     @map("display_name") @db.VarChar(120)
  status              UserStatus @default(active)
  passwordHash        String?    @map("password_hash") @db.Text
  passwordHashVersion Int?       @map("password_hash_version")
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  authenticationEvents   AuthenticationEvent[]
  authenticationSessions AuthenticationSession[]
  memberships            OrganizationMembership[]

  @@map("users")
}

model OrganizationMembership {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  roles          OrganizationRole[]
  status         MembershipStatus   @default(active)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization                 Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                         User                             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvalSnapshots            ApprovalSnapshot[]
  authenticationSessions       AuthenticationSession[]
  actedAuthenticationEvents    AuthenticationEvent[]            @relation("AuthenticationEventActor")
  auditEvents                  AuditEvent[]
  actedConfigurationEvents     OrganizationConfigurationEvent[]
  contentBriefRuns             ContentBriefRun[]
  generationRuns               GenerationRun[]
  generationAttempts           GenerationAttempt[]
  createdMedia                 MediaAsset[]
  createdPublications          Publication[]
  createdRevisions             PublicationRevision[]
  idempotencyRecords           IdempotencyRecord[]
  stateTransitions             PublicationStateTransition[]
  targetedAuthenticationEvents AuthenticationEvent[]            @relation("AuthenticationEventTarget")

  @@unique([organizationId, userId], map: "memberships_organization_user_key")
  @@unique([organizationId, id], map: "memberships_organization_id_key")
  @@unique([organizationId, userId, id], map: "memberships_organization_user_id_key")
  @@index([userId, status], map: "memberships_user_status_idx")
  @@map("organization_memberships")
}

model AuthenticationSession {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  membershipId          String    @map("membership_id") @db.Uuid
  tokenHash             String    @unique(map: "authentication_sessions_token_hash_key") @map("token_hash") @db.Char(64)
  csrfTokenHash         String    @map("csrf_token_hash") @db.Char(64)
  clientFingerprintHash String?   @map("client_fingerprint_hash") @db.Char(64)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt            DateTime  @map("last_seen_at") @db.Timestamptz(3)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason          String?   @map("revoke_reason") @db.VarChar(80)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  membership   OrganizationMembership @relation(fields: [organizationId, userId, membershipId], references: [organizationId, userId, id], onDelete: Restrict, onUpdate: Cascade)
  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, revokedAt, expiresAt], map: "authentication_sessions_user_active_idx")
  @@index([organizationId, membershipId, revokedAt], map: "authentication_sessions_membership_active_idx")
  @@index([expiresAt], map: "authentication_sessions_expiry_idx")
  @@map("authentication_sessions")
}

model AuthenticationEvent {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String?                 @map("organization_id") @db.Uuid
  userId                String?                 @map("user_id") @db.Uuid
  actorMembershipId     String?                 @map("actor_membership_id") @db.Uuid
  targetMembershipId    String?                 @map("target_membership_id") @db.Uuid
  eventType             AuthenticationEventType @map("event_type")
  succeeded             Boolean
  subjectHash           String?                 @map("subject_hash") @db.Char(64)
  clientFingerprintHash String?                 @map("client_fingerprint_hash") @db.Char(64)
  occurredAt            DateTime                @map("occurred_at") @db.Timestamptz(3)
  metadata              Json
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor        OrganizationMembership? @relation("AuthenticationEventActor", fields: [organizationId, actorMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  organization Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  target       OrganizationMembership? @relation("AuthenticationEventTarget", fields: [organizationId, targetMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  user         User?                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([subjectHash, clientFingerprintHash, eventType, occurredAt(sort: Desc)], map: "authentication_events_login_limit_idx")
  @@index([organizationId, occurredAt(sort: Desc)], map: "authentication_events_org_occurred_idx")
  @@map("authentication_events")
}

model Brand {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(120)
  profile        Json
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  locations    Location[]

  @@unique([organizationId, name], map: "brands_organization_name_key")
  @@unique([organizationId, id], map: "brands_organization_id_key")
  @@map("brands")
}

model Location {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  name           String   @db.VarChar(120)
  addressLine    String   @map("address_line") @db.VarChar(200)
  city           String   @db.VarChar(120)
  province       String   @db.VarChar(120)
  timeZone       String   @default("America/Argentina/Cordoba") @map("time_zone") @db.VarChar(80)
  phone          String?  @db.VarChar(40)
  whatsapp       String?  @db.VarChar(40)
  openingHours   Json     @map("opening_hours")
  isActive       Boolean  @default(true) @map("is_active")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brand            Brand             @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  publications     Publication[]
  contentBriefRuns ContentBriefRun[]

  @@unique([organizationId, name], map: "locations_organization_name_key")
  @@unique([organizationId, id], map: "locations_organization_id_key")
  @@index([organizationId, isActive, name], map: "locations_org_active_name_idx")
  @@map("locations")
}

model OrganizationConfigurationEvent {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  actorMembershipId String                  @map("actor_membership_id") @db.Uuid
  targetType        ConfigurationTargetType @map("target_type")
  targetId          String                  @map("target_id") @db.Uuid
  before            Json
  after             Json
  occurredAt        DateTime                @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @default(now()) @map("updated_at") @db.Timestamptz(3)

  actor        OrganizationMembership @relation(fields: [organizationId, actorMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, occurredAt(sort: Desc)], map: "configuration_events_org_occurred_idx")
  @@index([organizationId, targetType, targetId, occurredAt(sort: Desc)], map: "configuration_events_target_idx")
  @@map("organization_configuration_events")
}

model Publication {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  locationId            String?           @map("location_id") @db.Uuid
  createdByMembershipId String            @map("created_by_membership_id") @db.Uuid
  title                 String            @db.VarChar(180)
  status                PublicationStatus @default(draft)
  version               Int               @default(1)
  scheduledFor          DateTime?         @map("scheduled_for") @db.Timestamptz(3)
  timeZone              String            @default("America/Argentina/Cordoba") @map("time_zone") @db.VarChar(80)
  failureCode           String?           @map("failure_code") @db.VarChar(80)
  failureMessage        String?           @map("failure_message") @db.VarChar(300)
  failureRetryable      Boolean?          @map("failure_retryable")
  failureOccurredAt     DateTime?         @map("failure_occurred_at") @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location          Location?                    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  createdBy         OrganizationMembership       @relation(fields: [organizationId, createdByMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  approvalSnapshots ApprovalSnapshot[]
  revisions         PublicationRevision[]
  stateTransitions  PublicationStateTransition[]

  @@unique([organizationId, id], map: "publications_organization_id_key")
  @@index([organizationId, status, createdAt(sort: Desc), id], map: "publications_org_status_created_idx")
  @@index([organizationId, scheduledFor, id], map: "publications_org_scheduled_idx")
  @@index([organizationId, locationId, createdAt(sort: Desc)], map: "publications_org_location_created_idx")
  @@map("publications")
}

model PublicationRevision {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String                    @map("organization_id") @db.Uuid
  publicationId         String                    @map("publication_id") @db.Uuid
  createdByMembershipId String                    @map("created_by_membership_id") @db.Uuid
  revisionNumber        Int                       @map("revision_number")
  status                PublicationRevisionStatus @default(draft)
  schemaVersion         Int                       @map("schema_version")
  content               Json
  designDocument        Json                      @map("design_document")
  contentHash           String                    @map("content_hash") @db.Char(64)
  contentBriefRunId     String?                   @map("content_brief_run_id") @db.Uuid
  renderedMediaAssetId  String?                   @map("rendered_media_asset_id") @db.Uuid
  renderedAt            DateTime?                 @map("rendered_at") @db.Timestamptz(3)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  publication      Publication                  @relation(fields: [organizationId, publicationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  createdBy        OrganizationMembership       @relation(fields: [organizationId, createdByMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  approvalSnapshot ApprovalSnapshot?
  contentBriefRun  ContentBriefRun?             @relation(fields: [organizationId, contentBriefRunId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  media            PublicationRevisionMedia[]
  renderedMedia    MediaAsset?                  @relation("PublicationRenderedMedia", fields: [organizationId, renderedMediaAssetId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  stateTransitions PublicationStateTransition[] @relation("TransitionNewRevision")

  @@unique([organizationId, id], map: "revisions_organization_id_key")
  @@unique([organizationId, publicationId, revisionNumber], map: "revisions_publication_number_key")
  @@index([organizationId, status, updatedAt(sort: Desc)], map: "revisions_org_status_updated_idx")
  @@map("publication_revisions")
}

model ApprovalSnapshot {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  publicationId          String   @map("publication_id") @db.Uuid
  revisionId             String   @map("revision_id") @db.Uuid
  approvedByMembershipId String   @map("approved_by_membership_id") @db.Uuid
  approvedAt             DateTime @map("approved_at") @db.Timestamptz(3)
  contentHash            String   @map("content_hash") @db.Char(64)
  snapshot               Json
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  publication      Publication                  @relation(fields: [organizationId, publicationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  revision         PublicationRevision          @relation(fields: [organizationId, revisionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  approvedBy       OrganizationMembership       @relation(fields: [organizationId, approvedByMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  stateTransitions PublicationStateTransition[] @relation("TransitionApprovalSnapshot")

  @@unique([organizationId, revisionId], map: "approval_snapshots_revision_key")
  @@unique([organizationId, id], map: "approval_snapshots_organization_id_key")
  @@index([organizationId, publicationId, approvedAt(sort: Desc)], map: "approval_snapshots_org_publication_approved_idx")
  @@map("approval_snapshots")
}

model MediaAsset {
