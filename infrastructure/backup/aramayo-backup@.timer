[Unit]
Description=Copia diaria de PostgreSQL de Aramayo Content Platform (%i)

[Timer]
# 03:30 en Córdoba: fuera del horario comercial y lejos de las historias de
# apertura. `Persistent` corre la copia perdida si el host estuvo apagado.
OnCalendar=*-*-* 06:30:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
