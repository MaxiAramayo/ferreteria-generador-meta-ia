#!/usr/bin/env bash
# Recibe credenciales de proveedores para staging y las escribe en su entorno.
#
# Lo invoca `load-provider-credentials.sh` desde la máquina de quien administra
# las credenciales, con las variables por la entrada estándar: nunca pasan por
# argumentos ni se imprimen. Sólo acepta los grupos de proveedores de la lista;
# el resto del entorno —base, Redis, llave de cifrado, Meta— no se puede tocar
# por acá.
#
# Instalado en el VPS como /usr/local/sbin/aramayo-staging-credentials (0750
# root:root).

set -euo pipefail
umask 077

readonly ENV_FILE=/etc/aramayo-content/staging.env
readonly COMPOSE_FILE=/opt/aramayo-content-staging/current/compose.yaml
readonly ALLOWED='^(OPENAI_API_KEY|OPENAI_PROJECT_ID|OPENAI_VECTOR_STORE_ID|CLOUDINARY_CLOUD_NAME|CLOUDINARY_API_KEY|CLOUDINARY_API_SECRET|CLOUDINARY_FOLDER|ODOO_CONTENT_API_BASE_URL|ODOO_CONTENT_API_TOKEN|ODOO_CONTENT_API_ORGANIZATION_ID|ODOO_CONTENT_API_LOCATION_MAP)=.+$'

payload="$(mktemp)"
merged="$(mktemp "$(dirname "$ENV_FILE")/.staging.env.XXXXXX")"
trap 'rm -f "$payload" "$merged"' EXIT
cat >"$payload"

if [[ ! -s "$payload" ]]; then
  echo "No llegó ninguna variable; no se tocó el entorno." >&2
  exit 1
fi
if grep -vqE "$ALLOWED" "$payload"; then
  echo "Llegó una variable fuera de la lista permitida; no se tocó el entorno." >&2
  exit 1
fi

backup="$ENV_FILE.antes-credenciales-$(date -u +%Y%m%dT%H%M%SZ)"
cp -p "$ENV_FILE" "$backup"

awk -v payload="$payload" '
  BEGIN {
    while ((getline line < payload) > 0) {
      name = substr(line, 1, index(line, "=") - 1)
      values[name] = line
    }
  }
  {
    name = substr($0, 1, index($0, "=") - 1)
    if (name in values) {
      print values[name]
      seen[name] = 1
    } else {
      print
    }
  }
  END {
    for (name in values) {
      if (!(name in seen)) print values[name]
    }
  }
' "$ENV_FILE" >"$merged"
chown root:root "$merged"
chmod 600 "$merged"

if ! docker compose --env-file "$merged" --file "$COMPOSE_FILE" config --quiet; then
  echo "El entorno resultante no valida; se conserva el anterior." >&2
  exit 1
fi

mv -- "$merged" "$ENV_FILE"
cut -d= -f1 "$payload" | sed 's/^/actualizada: /'
echo "Copia del entorno anterior: $backup"
