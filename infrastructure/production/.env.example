# Identidad del despliegue. IMAGE_TAG debe ser el SHA exacto del commit.
COMPOSE_PROJECT_NAME=aramayo-content-production
IMAGE_REGISTRY=ghcr.io/maxiaramayo
IMAGE_TAG=
BUILD_DATE=

# DNS: ambos registros A apuntan exclusivamente al nuevo VPS.
WEB_DOMAIN=content.ferreteriaaramayo.com.ar
API_DOMAIN=api.content.ferreteriaaramayo.com.ar
ACME_EMAIL=

NODE_ENV=production
APP_TIMEZONE=America/Argentina/Cordoba
AUTH_SESSION_TTL_SECONDS=43200
WORKER_CONCURRENCY=1

# Generar contraseñas URL-safe independientes. No reutilizar las del VPS actual.
POSTGRES_USER=aramayo
POSTGRES_PASSWORD=
POSTGRES_DB=aramayo_content
REDIS_PASSWORD=
TOKEN_ENCRYPTION_KEYS=

# Los grupos de proveedor vacíos permanecen deshabilitados.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_VECTOR_STORE_ID=
OPENAI_MODEL_ROUTINE=gpt-5.6-luna
OPENAI_MODEL_BRIEF=gpt-5.6-terra
OPENAI_MODEL_COMPLEX=gpt-5.6-sol
OPENAI_REQUEST_TIMEOUT_MS=60000
OPENAI_MAX_INPUT_CHARACTERS=50000
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BASE_DELAY_MS=500

ODOO_CONTENT_API_BASE_URL=
ODOO_CONTENT_API_TOKEN=
ODOO_CONTENT_API_ORGANIZATION_ID=
ODOO_CONTENT_API_LOCATION_MAP=
ODOO_CONTENT_API_TIMEOUT_MS=8000
ODOO_CONTENT_API_MAX_CALLS=8

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_API_VERSION=
META_PAGE_ID=
