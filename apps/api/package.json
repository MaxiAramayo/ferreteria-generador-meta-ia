{
  "name": "@aramayo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "pnpm run build && node ../../tools/run-with-env.mjs node --enable-source-maps --watch dist/main.js",
    "dev:types": "tsc --project tsconfig.build.json --watch",
    "start": "node ../../tools/run-with-env.mjs node --enable-source-maps dist/main.js",
    "test": "node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@aramayo/configuration": "workspace:*",
    "@aramayo/contracts": "workspace:*",
    "@aramayo/database": "workspace:*",
    "@aramayo/domain": "workspace:*",
    "@aramayo/process-health": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "argon2": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "cookie": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:"
  }
}
