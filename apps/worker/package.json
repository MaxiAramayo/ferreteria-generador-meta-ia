{
  "name": "@aramayo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "pnpm run build && node ../../tools/run-with-env.mjs node --enable-source-maps --watch dist/main.js",
    "dev:types": "tsc --project tsconfig.build.json --watch",
    "smoke:cloudinary": "node ../../tools/run-with-env.mjs node src/media/cloudinary-smoke.ts",
    "start": "node ../../tools/run-with-env.mjs node --enable-source-maps dist/main.js",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@aramayo/brand-knowledge": "workspace:*",
    "@aramayo/configuration": "workspace:*",
    "@aramayo/contracts": "workspace:*",
    "@aramayo/database": "workspace:*",
    "@aramayo/design-engine": "workspace:*",
    "@aramayo/domain": "workspace:*",
    "@aramayo/process-health": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "cloudinary": "catalog:",
    "playwright-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "sharp": "catalog:",
    "@fontsource/archivo": "catalog:",
    "@fontsource/saira-condensed": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
